# Copy this file to .env and fill in real values before running.
# .env is gitignored and never committed.

# Required: master key for bootstrap and emergency admin access.
# Generate with: python3 -c "import secrets; print('mk_' + secrets.token_hex(32))"
PALLET_PRO_MASTER_KEY=

# Optional: override number of gunicorn workers (default: 2*CPU+1)
# GUNICORN_WORKERS=4
