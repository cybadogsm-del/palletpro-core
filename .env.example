# Copy this file to .env and fill in real values before running.
# .env is gitignored and never committed.

# Required: master key for bootstrap and emergency admin access.
# Generate with: python3 -c "import secrets; print('mk_' + secrets.token_hex(32))"
PALLET_PRO_MASTER_KEY=

# Optional: override number of gunicorn workers (default: 2*CPU+1)
# GUNICORN_WORKERS=4

# Web Push (VAPID) — generate once with: python generate_vapid_keys.py
# Changing these keys invalidates ALL existing push subscriptions.
# VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VAPID_PUBLIC_KEY="BN4UGR7..."
# VAPID_CONTACT="mailto:admin@palletpro.app"

# Referral / install tracking — base URL for install links
# PALLET_PRO_INSTALL_URL="https://palletpro.app/install"
